@using Microsoft.AspNetCore.Components

<div class="pagination-container">
    <div class="pagination-controls">
        <button class="pagination-btn" @onclick="GoToFirstPage" disabled="@(CurrentPage == 1)">
            &lt;
        </button>
        
        @foreach (var pg in GetVisiblePages())
        {
            @if (pg == -1)
            {
                <span class="pagination-ellipsis">...</span>
            }
            else
            {
                <button class="pagination-btn @(pg == CurrentPage ? "active" : "")" 
                        @onclick="() => GoToPage(pg)">
                    @pg
                </button>
            }
        }
        
        <button class="pagination-btn" @onclick="GoToLastPage" disabled="@(CurrentPage == TotalPages)">
            &gt;
        </button>
    </div>
    
    <div class="pagination-info">
        <div class="pagination-results">
            Results: @((CurrentPage - 1) * ItemsPerPage + 1) - @(Math.Min(CurrentPage * ItemsPerPage, TotalItems)) of @TotalItems
        </div>
        <div class="pagination-items-per-page">
            <label>Items per page:</label>
            <select value="@ItemsPerPage" @onchange="HandleItemsPerPageChanged">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int ItemsPerPage { get; set; } = 10;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnItemsPerPageChangedCallback { get; set; }

    private int TotalPages => (int)Math.Ceiling((double)TotalItems / ItemsPerPage);

    private List<int> GetVisiblePages()
    {
        var pages = new List<int>();
        var maxVisible = 7;
        var sidePages = 2;

        if (TotalPages <= maxVisible)
        {
            for (int i = 1; i <= TotalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Always show first page
            pages.Add(1);

            int startPage = Math.Max(2, CurrentPage - sidePages);
            int endPage = Math.Min(TotalPages - 1, CurrentPage + sidePages);

            if (startPage > 2)
            {
                pages.Add(-1); // Ellipsis
            }

            for (int i = startPage; i <= endPage; i++)
            {
                pages.Add(i);
            }

            if (endPage < TotalPages - 1)
            {
                pages.Add(-1); // Ellipsis
            }

            // Always show last page
            if (TotalPages > 1)
            {
                pages.Add(TotalPages);
            }
        }

        return pages;
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            CurrentPage = page;
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private async Task GoToFirstPage()
    {
        if (CurrentPage > 1)
        {
            await GoToPage(1);
        }
    }

    private async Task GoToLastPage()
    {
        if (CurrentPage < TotalPages)
        {
            await GoToPage(TotalPages);
        }
    }

    private async Task HandleItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newItemsPerPage) && newItemsPerPage > 0)
        {
            ItemsPerPage = newItemsPerPage;
            CurrentPage = 1; // Reset to first page when changing items per page
            await OnItemsPerPageChangedCallback.InvokeAsync(newItemsPerPage);
            await OnPageChanged.InvokeAsync(1);
        }
    }
}
