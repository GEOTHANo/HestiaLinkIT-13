    }

    /* Modal - Same as CheckInCheckOut */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(16, 47, 51, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 40;
    }

    .modal-content {
        background: white;
        border-radius: 10px;
        width: 90%;
        max-width: 480px;
        box-shadow: 0 10px 30px rgba(2, 6, 23, 0.4);
    }

    .modal-header-teal {
        background: #00535b;
        color: white;
        padding: 14px 18px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-header {
        background: #00535b;
        color: white;
        padding: 12px 16px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-header h2 {
        color: #ffffff;
        margin: 0;
        font-weight: 700;
    }

    .action-footer {
        padding: 12px 16px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #334155;
    }

    .form-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #e6eef0;
        border-radius: 8px;
        font-size: 0.95rem;
        box-sizing: border-box;
    }

    textarea.form-input {
        resize: vertical;
        min-height: 80px;
    }

    /* Loading */
    .loading-state {
        text-align: center;
        padding: 60px 20px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e5e7eb;
        border-top-color: #0f766e;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 16px;
    }

    .loading-state p {
        color: #6b7280;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .room-grid,
        .cards-grid {
            grid-template-columns: 1fr;
        }

        .tab-group {
            width: 100%;
            flex-direction: column;
        }

        .tab-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

@code {
    private List<Room> RoomsForCleaning = new();
    private List<Room> RoomsUnderMaintenance = new();
    private List<CleaningTask> ActiveTasks = new();
    private List<SystemUser> AvailableHousekeepers = new();

    private string ActiveTab = "cleaning";
    private bool ShowAssignModal = false;
    private bool ShowAdminCompleteModal = false;
    private bool IsLoaded = false;
    private bool HasError = false;
    private bool IsProcessing = false;
    private string ErrorMessage = string.Empty;

    private Room? SelectedRoom;
    private CleaningTask? SelectedTask;
    private int SelectedUserID = 0;
    private string TaskNotes = "Standard Cleaning";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private string GetAvatarInitials(string roomNumber)
    {
        if (string.IsNullOrWhiteSpace(roomNumber)) return "RM";
        var trimmed = roomNumber.Trim();
        return trimmed.Length <= 2 ? trimmed : trimmed[..2];
    }

    private async Task LoadData()
    {
        try
        {
            HasError = false;
            ErrorMessage = string.Empty;
            IsLoaded = false;
            StateHasChanged();

            RoomsForCleaning = await HousekeepingService.GetRoomsForCleaningAsync();
            RoomsUnderMaintenance = await HousekeepingService.GetRoomsUnderMaintenanceAsync();
            ActiveTasks = await HousekeepingService.GetActiveTasksAsync();
            AvailableHousekeepers = await HousekeepingService.GetAvailableHousekeepersAsync();

            IsLoaded = true;
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = ex.Message;
            IsLoaded = true;
        }

        StateHasChanged();
    }

    private void SwitchTab(string tab) => ActiveTab = tab;

    private async Task OpenAssignModal(Room room)
    {
        SelectedRoom = room;
        SelectedUserID = 0;
        TaskNotes = "Standard Cleaning";

        try
        {
            AvailableHousekeepers = await HousekeepingService.GetAvailableHousekeepersAsync();
        }
        catch { }

        ShowAssignModal = true;
        StateHasChanged();
    }

    private void CloseAssignModal()
    {
        ShowAssignModal = false;
        SelectedRoom = null;
        SelectedUserID = 0;
    }

    private async Task SaveAssignment()
    {
        if (SelectedRoom == null || SelectedUserID == 0 || IsProcessing) return;

        try
        {
            IsProcessing = true;
            StateHasChanged();

            var result = await HousekeepingService.AssignTaskAsync(
                SelectedRoom.RoomID,
                SelectedUserID,
                TaskNotes);

            if (result.Success)
            {
                CloseAssignModal();
                await LoadData();
                await JSRuntime.InvokeVoidAsync("alert", "Task assigned successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Message);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private void AdminCompleteTask(CleaningTask task)
    {
        SelectedTask = task;
        ShowAdminCompleteModal = true;
    }

    private void CloseAdminCompleteModal()
    {
        ShowAdminCompleteModal = false;
        SelectedTask = null;
    }

    private async Task ConfirmAdminComplete()
    {
        if (SelectedTask == null || IsProcessing) return;

        try
        {
            IsProcessing = true;
            StateHasChanged();

            var userId = SelectedTask.UserID ?? 0;
            if (userId == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Cannot complete: No user assigned");
                return;
            }

            var result = await HousekeepingService.CompleteTaskAsync(SelectedTask.TaskID, userId, "Cleaned");

            CloseAdminCompleteModal();

            if (result.Success)
            {
                await LoadData();
                await JSRuntime.InvokeVoidAsync("alert", "Task completed!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Message);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task MarkRoomClean(Room room)
    {
        if (room == null || IsProcessing) return;

        try
        {
            IsProcessing = true;
            StateHasChanged();

            var success = await HousekeepingService.UpdateRoomStatusAsync(room.RoomID, "Available");

            if (success)
            {
                await LoadData();
                await JSRuntime.InvokeVoidAsync("alert", $"Room {room.RoomNumber} marked clean.");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Failed to update room status.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

