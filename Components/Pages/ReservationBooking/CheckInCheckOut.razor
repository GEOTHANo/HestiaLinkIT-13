        ShowCheckOutModal = false;
    }



    private async Task ProcessCheckOut()
    {
        if (SelectedRoom == null) return;

        try
        {
            // Clear entity tracking
            DbContext.ChangeTracker.Clear();

            // Get the execution strategy
            var executionStrategy = DbContext.Database.CreateExecutionStrategy();

            await executionStrategy.ExecuteAsync(async () =>
            {
                // Create transaction inside execution strategy
                using var transaction = await DbContext.Database.BeginTransactionAsync();

                try
                {
                    // Clear tracking first
                    DbContext.ChangeTracker.Clear();

                    // Find the room
                    var roomEntity = await DbContext.Rooms
                        .Where(r => r.RoomNumber == SelectedRoom.RoomNumber)
                        .FirstOrDefaultAsync();

                    if (roomEntity == null)
                    {
                        await transaction.RollbackAsync();
                        await SafeJsInvoke("alert", $"Room {SelectedRoom.RoomNumber} not found");
                        return;
                    }

                    // Update room status
                    roomEntity.Status = "For Cleaning";
                    await DbContext.SaveChangesAsync();

                    // Find the active reservation for this room
                    var reservationData = await DbContext.Reservations
                        .Join(DbContext.ReservedRooms,
                            r => r.ReservationId,
                            rr => rr.ReservationId,
                            (r, rr) => new { r, rr })
                        .Where(x => x.rr.RoomId == roomEntity.RoomId && x.r.Status == "Checked In")
                        .Select(x => new
                        {
                            Reservation = x.r,
                            ReservedRoom = x.rr
                        })
                        .FirstOrDefaultAsync();

                    if (reservationData != null)
                    {
                        // Update reservation status
                        reservationData.Reservation.Status = "Checked Out";
                        reservationData.Reservation.PaymentStatus = "Paid";

                        // Save reservation changes
                        await DbContext.SaveChangesAsync();

                        // Find and update the bill
                        var bill = await DbContext.Bills
                            .Where(b => b.ReservationId == reservationData.Reservation.ReservationId)
                            .FirstOrDefaultAsync();

                        if (bill != null)
                        {
                            bill.BillStatus = "Paid";
                            bill.AmountPaid = bill.GrandTotal;
                            bill.BalanceDue = 0;

                            await DbContext.SaveChangesAsync();

                            // Create payment record if it doesn't exist
                            var existingPayment = await DbContext.Payments
                                .Where(p => p.BillId == bill.BillId && p.PaymentStatus == "Completed")
                                .FirstOrDefaultAsync();

                            Payment payment = null;
                            if (existingPayment == null)
                            {
                                var currentUserId = GetCurrentUserId();

                                payment = new Payment
                                {
                                    BillId = bill.BillId,
                                    PaymentDate = DateTime.Now,
                                    PaymentMethod = "Cash",
                                    Amount = bill.GrandTotal,
                                    ReferenceNumber = GenerateReferenceNumber(),
                                    PaymentStatus = "Completed",
                                    ProcessedBy = currentUserId
                                };

                                DbContext.Payments.Add(payment);
                                await DbContext.SaveChangesAsync();
                            }
                            else
                            {
                                payment = existingPayment;
                            }

                            // ========== CREATE INCOME RECORD AUTOMATICALLY ==========
                            if (payment != null)
                            {
                                var income = new Income
                                {
                                    PaymentId = payment.PaymentId,
                                    IncomeDate = DateOnly.FromDateTime(DateTime.Today),
                                    Amount = payment.Amount,
                                    IncomeType = "Checkout",
                                    Description = "CheckInAndCheckout",
                                    CreatedDate = DateTime.Now
                                };

                                DbContext.Incomes.Add(income);
                                await DbContext.SaveChangesAsync();
                            }
                            // ========================================================
                        }
                    }

                    // Commit all changes
                    await transaction.CommitAsync();

                    // Clear entity tracking
                    DbContext.ChangeTracker.Clear();

                    // Update UI
                    SelectedRoom.Status = "For Cleaning";
                    SelectedRoom.ServiceCharge = 0;
                    SelectedRoom.TaxAmount = 0;
                    SelectedRoom.TotalDue = 0;

                    ShowCheckOutModal = false;

                    await SafeJsInvoke("alert", $"Check-out successful. Room {SelectedRoom.RoomNumber} marked for cleaning");
                }
                catch
                {
                    await transaction.RollbackAsync();
                    throw;
                }
            });

            // Reload rooms with fresh data
            await LoadRoomsFromView();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error processing check-out: {ex.Message}");
            Console.WriteLine($"Inner Exception: {ex.InnerException?.Message}");
            Console.WriteLine($"Stack Trace: {ex.StackTrace}");

            await SafeJsInvoke("alert", $"Error processing check-out: {ex.InnerException?.Message ?? ex.Message}");
        }
    }

    private string GetOccupancyRate()
    {
        if (!Rooms.Any()) return "0";
        var occ = Rooms.Count(r => r.Status == "Occupied");
        return ((int)Math.Round(occ * 100.0 / Rooms.Count)).ToString();
    }

    private string GetAvatarInitials(string roomNumber)
    {
        if (string.IsNullOrWhiteSpace(roomNumber)) return "RM";
        var trimmed = roomNumber.Trim();
        return trimmed.Length <= 2 ? trimmed : trimmed.Substring(0, 2);
    }

    private async Task<decimal> CalculateRoomCharge(int roomId, DateOnly checkIn, DateOnly checkOut)
    {
        var room = await DbContext.Rooms
            .AsNoTracking()
            .Include(r => r.RoomType)
            .FirstOrDefaultAsync(r => r.RoomId == roomId);
        if (room == null) return 0m;
        var nights = checkOut.DayNumber - checkIn.DayNumber;
        if (nights <= 0) nights = 1;
        var basePrice = room.RoomType?.BasePrice ?? 0m;
        return basePrice * nights;
    }

