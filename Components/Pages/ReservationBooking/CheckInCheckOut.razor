    // Inventory requirement checking (async version for actual checks)
    private async Task<List<InventoryRequirement>> CheckServiceInventoryRequirements(int serviceId)
    {
        var requirements = new List<InventoryRequirement>();
        
        var service = AvailableServices.FirstOrDefault(s => s.ServiceId == serviceId);
        if (service == null || service.ServiceCategoryId == null)
            return requirements;
        
        // Refresh inventory cache to get latest stock levels
        await LoadServiceCategoryInventory();
        
        // Get inventory items for this service's category
        if (ServiceCategoryInventoryCache.TryGetValue(service.ServiceCategoryId.Value, out var inventoryItems))
        {
            foreach (var item in inventoryItems)
            {
                int quantityToDeduct = DetermineQuantityToDeduct(item, service);
                
                requirements.Add(new InventoryRequirement
                {
                    InventoryItemId = item.ItemId,
                    ItemName = item.ItemName,
                    RequiredQuantity = quantityToDeduct,
                    AvailableQuantity = item.CurrentStock ?? 0
                });
            }
        }
        
        return requirements;
    }

    // Synchronous version for UI display (uses cached data)
    private List<InventoryRequirement> GetServiceInventoryRequirementsSync(int serviceId)
    {
        var requirements = new List<InventoryRequirement>();
        
        var service = AvailableServices.FirstOrDefault(s => s.ServiceId == serviceId);
        if (service == null || service.ServiceCategoryId == null)
            return requirements;
        
        // Get inventory items for this service's category from cache
        if (ServiceCategoryInventoryCache.TryGetValue(service.ServiceCategoryId.Value, out var inventoryItems))
        {
            foreach (var item in inventoryItems)
            {
                int quantityToDeduct = DetermineQuantityToDeduct(item, service);
                
                requirements.Add(new InventoryRequirement
                {
                    InventoryItemId = item.ItemId,
                    ItemName = item.ItemName,
                    RequiredQuantity = quantityToDeduct,
                    AvailableQuantity = item.CurrentStock ?? 0
                });
            }
        }
        
        return requirements;
    }

    private int DetermineQuantityToDeduct(InventoryItem item, Service service)
    {
        // CUSTOMIZE THESE RULES FOR YOUR BUSINESS
        return service.ServiceCategory?.ServiceCategoryName?.ToUpper() switch
        {
            "AMENITIES" => item.Category.ToUpper() switch
            {
                "AMENITIES" => 1,  // 1 set of amenities per service
                _ => 1
            },
            "SPA & WELLNESS" => item.Category.ToUpper() switch
            {
                "AMENITIES" => 2,  // Spa uses 2 towels, 2 robes, etc.
                _ => 1
            },
            "HOUSEKEEPING" => item.Category.ToUpper() switch
            {
                "CLEANING" => 1,   // 1 cleaning item per service
                "AMENITIES" => 1,  // Replace amenities during cleaning
                _ => 1
            },
            _ => 1  // Default
        };
    }

    public class InventoryRequirement
    {
        public int InventoryItemId { get; set; }
        public string ItemName { get; set; } = string.Empty;
        public int RequiredQuantity { get; set; }
        public int AvailableQuantity { get; set; }
        public bool HasSufficientStock => AvailableQuantity >= RequiredQuantity;
    }

