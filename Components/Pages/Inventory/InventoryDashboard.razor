@page "/inventory/dashboard"
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using HestiaLink.Services
@inject IJSRuntime JSRuntime
@inject HestiaLinkContext DbContext
@inject HousekeepingService HousekeepingService

<div class="page-wrapper">
    <div class="page-topbar">
        <div>
            <h1>Inventory Dashboard</h1>
            <div class="page-topbar-subtitle">Real-time Inventory Overview</div>
        </div>
        <UserDropdown />
    </div>

    <div class="page-content">
        @if (!IsLoaded)
    {
        <div class="loading">Loading inventory data...</div>
    }
    else
    {
        @* ===== HERO STATS (like main Dashboard) ===== *@
        <div class="dashboard-hero">
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/></svg>
                </div>
                <div class="hero-stat-value">@TotalItems</div>
                <div class="hero-stat-label">Inventory Items</div>
                <div class="hero-stat-change">@CategoryCount categories</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                </div>
                <div class="hero-stat-value">@LowStockCount</div>
                <div class="hero-stat-label">Low Stock Alerts</div>
                <div class="hero-stat-change">need reorder</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                </div>
                <div class="hero-stat-value">₱@TotalStockValue.ToString("N0")</div>
                <div class="hero-stat-label">Total Stock Value</div>
                <div class="hero-stat-change">current inventory</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                </div>
                <div class="hero-stat-value">@TodaysConsumption</div>
                <div class="hero-stat-label">Today's Usage</div>
                <div class="hero-stat-change">items consumed</div>
            </div>
        </div>

        @* ===== QUICK STATS ROW (like main Dashboard) ===== *@
        <div class="quick-stats-row">
            <div class="quick-stat">
                <div class="quick-stat-value">@ServiceItemsCount</div>
                <div class="quick-stat-label">Service Items</div>
                <div class="quick-stat-desc">linked to services</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value">@TotalEmployees</div>
                <div class="quick-stat-label">Staff</div>
                <div class="quick-stat-desc">@PresentEmployees present</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value">@RoomsForCleaning</div>
                <div class="quick-stat-label">Rooms to Clean</div>
                <div class="quick-stat-desc">pending tasks</div>
            </div>
            <div class="quick-stat">
                <a href="/inventory/items" style="text-decoration:none; color:inherit;">
                    <div class="quick-stat-value" style="color:#0093a0;">→</div>
                    <div class="quick-stat-label">Manage Items</div>
                    <div class="quick-stat-desc">view all inventory</div>
                </a>
            </div>
            <div class="quick-stat">
                <a href="/inventory/reports" style="text-decoration:none; color:inherit;">
                    <div class="quick-stat-value" style="color:#0093a0;">→</div>
                    <div class="quick-stat-label">Reports</div>
                    <div class="quick-stat-desc">inventory analytics</div>
                </a>
            </div>
            <div class="quick-stat">
                <a href="/inventory/alerts" style="text-decoration:none; color:inherit;">
                    <div class="quick-stat-value" style="color:#dc2626;">@LowStockCount</div>
                    <div class="quick-stat-label">Alerts</div>
                    <div class="quick-stat-desc">view low stock</div>
                </a>
            </div>
        </div>

        <div class="dashboard-grid">
            @* ===== LOW STOCK ALERTS (Premium Design) ===== *@
            <div class="premium-card">
                <div class="premium-card-header">
                    <h3 class="premium-card-title">
                        <span class="card-icon">
                            <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                        </span>
                        Low Stock Alerts
                    </h3>
                    <a href="/inventory/alerts" style="font-size:0.85rem; font-weight:600; color:#0093a0; text-decoration:none;">View All</a>
                </div>
                <div class="premium-card-body">
                    @if (LowStockItems.Any())
                    {
                        <div class="activity-list">
                            @foreach (var item in LowStockItems.Take(5))
                            {
                                var currentStock = item.CurrentStock ?? 0;
                                var reorderPoint = item.ReorderPoint ?? 0;
                                <div class="activity-item">
                                    <div class="activity-avatar" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); color: white;">
                                        @if (!string.IsNullOrEmpty(item.ItemName))
                                        {
                                            @item.ItemName.Substring(0, 1).ToUpper()
                                        }
                                    </div>
                                    <div class="activity-content">
                                        <div class="activity-title">@item.ItemName</div>
                                        <div class="activity-meta">Reorder at @reorderPoint units</div>
                                    </div>
                                    <span class="activity-badge danger">@currentStock left</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                         <div class="empty-state-premium">
                            <div class="empty-state-icon">
                                <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                            </div>
                            <div class="empty-state-title">All Stocked!</div>
                            <div class="empty-state-desc">No items are currently below reorder levels.</div>
                        </div>
                    }
                </div>
            </div>

            @* ===== RECENT CONSUMPTION (Premium Design) ===== *@
            <div class="premium-card">
                <div class="premium-card-header">
                    <h3 class="premium-card-title">
                        <span class="card-icon">
                            <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                        </span>
                        Recent Consumption
                    </h3>
                    <a href="/inventory/reports" style="font-size:0.85rem; font-weight:600; color:#0093a0; text-decoration:none;">View All</a>
                </div>
                <div class="premium-card-body">
                    @if (RecentConsumptions.Any())
                    {
                        <table class="inventory-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Room</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var consumption in RecentConsumptions.Take(5))
                                {
                                    <tr>
                                        <td style="font-weight:600;">@(consumption.InventoryItem?.ItemName ?? "N/A")</td>
                                        <td>@consumption.QuantityConsumed @(consumption.InventoryItem?.UnitOfMeasure ?? "")</td>
                                        <td>@(consumption.RoomNumber ?? "-")</td>
                                        <td>@consumption.ConsumptionDate.ToString("MMM dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state-premium">
                            <div class="empty-state-icon">
                                <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                            </div>
                            <div class="empty-state-title">No Recent Activity</div>
                            <div class="empty-state-desc">Consumption records will appear here.</div>
                        </div>
                    }
                </div>
            </div>

            @* ===== INVENTORY BY CATEGORY (Premium Design) ===== *@
            <div class="premium-card">
                <div class="premium-card-header">
                    <h3 class="premium-card-title">
                        <span class="card-icon">
                            <svg viewBox="0 0 24 24"><path d="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/></svg>
                        </span>
                        Inventory by Category
                    </h3>
                </div>
                <div class="premium-card-body">
                    @if (CategoryBreakdown.Any())
                    {
                        <div class="activity-list">
                            @foreach (var cat in CategoryBreakdown)
                            {
                                <div class="activity-item">
                                    <div class="activity-avatar" style="background: linear-gradient(135deg, #0093a0 0%, #00535b 100%); color: white;">
                                        @if (!string.IsNullOrEmpty(cat.Category))
                                        {
                                            @cat.Category.Substring(0, 1).ToUpper()
                                        }
                                    </div>
                                    <div class="activity-content" style="flex:1;">
                                        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                            <span class="activity-title">@cat.Category</span>
                                            <span style="font-weight:700; color:#00535b;">₱@cat.TotalValue.ToString("N0")</span>
                                        </div>
                                        <div style="width:100%; height:6px; background:#e2e8f0; border-radius:3px; overflow:hidden;">
                                            <div style="width: @(cat.ItemCount * 100 / Math.Max(CategoryBreakdown.Max(c => c.ItemCount), 1))%; height:100%; background:#0093a0;"></div>
                                        </div>
                                        <div class="activity-meta" style="margin-top:4px;">@cat.ItemCount items</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state-premium">
                            <div class="empty-state-icon">
                                <svg viewBox="0 0 24 24"><path d="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/></svg>
                            </div>
                            <div class="empty-state-title">No Data</div>
                            <div class="empty-state-desc">Inventory categories will appear here.</div>
                        </div>
                    }
                </div>
            </div>

            @* ===== SERVICES USING INVENTORY (Premium Design) ===== *@
            <div class="premium-card">
                <div class="premium-card-header">
                    <h3 class="premium-card-title">
                        <span class="card-icon">
                            <svg viewBox="0 0 24 24"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
                        </span>
                        Services Inventory
                    </h3>
                </div>
                <div class="premium-card-body">
                    @if (ServicesWithInventory.Any())
                    {
                        <table class="inventory-table">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Links</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var service in ServicesWithInventory.Take(5))
                                {
                                    <tr>
                                        <td style="font-weight:600;">@service.ServiceName</td>
                                        <td>@service.LinkedItemsCount items</td>
                                        <td>
                                            <span class="status-badge status-confirmed">Active</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state-premium">
                            <div class="empty-state-icon">
                                <svg viewBox="0 0 24 24"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
                            </div>
                            <div class="empty-state-title">No Services Linked</div>
                            <div class="empty-state-desc">Services using inventory will appear here.</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    </div>
</div>

@code {
    private bool IsLoaded = false;

    // Summary data
    private int TotalItems = 0;
    private int LowStockCount = 0;
    private int CategoryCount = 0;
    private decimal TotalStockValue = 0;
    private int ServiceItemsCount = 0;
    private int TodaysConsumption = 0;

    // Employee data
    private int TotalEmployees = 0;
    private int PresentEmployees = 0;
    private int LateEmployees = 0;
    private int AbsentEmployees = 0;

    // Cleaning schedule data
    private int RoomsForCleaning = 0;
    private int ActiveCleaningTasks = 0;
    private int AvailableHousekeepers = 0;
    private int MaintenanceRooms = 0;

    // Lists
    private List<InventoryItem> LowStockItems = new();
    private List<InventoryConsumption> RecentConsumptions = new();
    private List<CategorySummary> CategoryBreakdown = new();
    private List<ServiceWithInventory> ServicesWithInventory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {

            // Get all active inventory items with proper null handling
            var inventoryItems = await DbContext.InventoryItems
                .Where(i => i.IsActive != null && i.IsActive.Value)
                .ToListAsync();

            TotalItems = inventoryItems.Count;
            TotalStockValue = inventoryItems.Sum(i => (i.CurrentStock ?? 0) * i.UnitCost);
            CategoryCount = inventoryItems.Select(i => i.Category).Distinct().Count();
            ServiceItemsCount = inventoryItems.Count(i => i.IsServiceItem == true);

            // Low stock items (at or below reorder point) with null-safe comparison
            LowStockItems = inventoryItems
                .Where(i => (i.CurrentStock ?? 0) <= (i.ReorderPoint ?? 0))
                .OrderBy(i => i.CurrentStock ?? 0)
                .ToList();
            LowStockCount = LowStockItems.Count;

            // Today's consumption count
            var today = DateTime.Today;
            TodaysConsumption = await DbContext.InventoryConsumptions
                .Where(c => c.ConsumptionDate.Date == today)
                .CountAsync();

            // Load employee data
            await LoadEmployeeData();

            // Load cleaning schedule data
            await LoadCleaningData();

            // Category breakdown with null-safe calculations
            CategoryBreakdown = inventoryItems
                .GroupBy(i => i.Category)
                .Select(g => new CategorySummary
                {
                    Category = g.Key,
                    ItemCount = g.Count(),
                    TotalValue = g.Sum(i => (i.CurrentStock ?? 0) * i.UnitCost)
                })
                .OrderByDescending(c => c.TotalValue)
                .ToList();

            // Recent consumptions
            RecentConsumptions = await DbContext.InventoryConsumptions
                .Include(c => c.InventoryItem)
                .OrderByDescending(c => c.ConsumptionDate)
                .Take(10)
                .ToListAsync();

            // Services with inventory links - handle nullable IsActive
            var serviceLinks = await DbContext.ServiceInventories
                .Include(si => si.Service)
                .Where(si => si.Service != null && si.Service.IsActive != null && si.Service.IsActive.Value)
                .ToListAsync();

            ServicesWithInventory = serviceLinks
                .GroupBy(si => si.ServiceId)
                .Select(g => new ServiceWithInventory
                {
                    ServiceId = g.Key,
                    ServiceName = g.First().Service?.ServiceName ?? "Unknown",
                    LinkedItemsCount = g.Count()
                })
                .OrderByDescending(s => s.LinkedItemsCount)
                .ToList();

            IsLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            // Silently handle error - show empty state instead
            IsLoaded = true;
        }
    }

    private async Task LoadEmployeeData()
    {
        try
        {
            var todayDate = DateOnly.FromDateTime(DateTime.Today);
            
            // Total active employees
            TotalEmployees = await DbContext.Employees.CountAsync(e => e.Status == "Active");

            // Get today's schedules
            var todaySchedules = await DbContext.Schedules
                .Where(s => s.ScheduleDate == todayDate && s.IsActive == true)
                .ToListAsync();

            var scheduleIds = todaySchedules.Select(s => s.ScheduleId).ToList();

            // Get today's attendances
            var todayAttendances = await DbContext.Attendances
                .Include(a => a.Schedule)
                .Where(a => a.AttendanceDate == todayDate && scheduleIds.Contains(a.ScheduleId))
                .ToListAsync();

            PresentEmployees = todayAttendances.Count(a => a.AttendanceStatus == "Present");
            AbsentEmployees = todayAttendances.Count(a => a.AttendanceStatus == "Absent");
            
            // Calculate late count (check-in time > scheduled start + 15 minutes)
            LateEmployees = todayAttendances.Count(a =>
                a.ActualCheckIn.HasValue &&
                a.Schedule != null &&
                a.ActualCheckIn.Value.TimeOfDay > a.Schedule.ScheduledStart.ToTimeSpan().Add(TimeSpan.FromMinutes(15)));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employee data: {ex.Message}");
        }
    }

    private async Task LoadCleaningData()
    {
        try
        {
            // Get rooms for cleaning
            var roomsForCleaningList = await HousekeepingService.GetRoomsForCleaningAsync();
            RoomsForCleaning = roomsForCleaningList.Count;

            // Get active tasks
            var activeTasksList = await HousekeepingService.GetActiveTasksAsync();
            ActiveCleaningTasks = activeTasksList.Count;

            // Get available housekeepers
            var availableHousekeepersList = await HousekeepingService.GetAvailableHousekeepersAsync();
            AvailableHousekeepers = availableHousekeepersList.Count;

            // Get rooms under maintenance
            var maintenanceRoomsList = await HousekeepingService.GetRoomsUnderMaintenanceAsync();
            MaintenanceRooms = maintenanceRoomsList.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cleaning data: {ex.Message}");
        }
    }


    // Helper classes
    private class CategorySummary
    {
        public string Category { get; set; } = string.Empty;
        public int ItemCount { get; set; }
        public decimal TotalValue { get; set; }
    }

    private class ServiceWithInventory
    {
        public int ServiceId { get; set; }
        public string ServiceName { get; set; } = string.Empty;
        public int LinkedItemsCount { get; set; }
    }
}

<style>
    /* ===== INVENTORY DASHBOARD - Uses global dashboard.css for hero-stat and quick-stat ===== */
    
    /* Dashboard Grid - 2 columns for panels */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 28px;
    }

    /* Panel Cards */
    .panel-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        background: linear-gradient(135deg, #0093a0 0%, #00535b 100%);
        color: white;
    }

    .panel-header h3 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 700;
        display: flex;
        align-items: center;
    }

    .view-all-link {
        color: rgba(255,255,255,0.85);
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .view-all-link:hover {
        color: white;
    }

    .panel-body {
        padding: 16px 20px;
        max-height: 320px;
        overflow-y: auto;
    }

    /* Inventory Table */
    .inventory-table {
        width: 100%;
        border-collapse: collapse;
    }

    .inventory-table th,
    .inventory-table td {
        padding: 12px 10px;
        text-align: left;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.85rem;
    }

    .inventory-table th {
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.7rem;
    }

    .inventory-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Inline SVG icons */
    .icon-inline {
        display: inline-block;
        width: 16px;
        height: 16px;
        vertical-align: middle;
        margin-right: 6px;
    }

    /* Stock Badge */
    .stock-badge {
        padding: 4px 10px;
        border-radius: 16px;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .stock-badge.critical {
        background: #fee2e2;
        color: #dc2626;
    }

    /* Status Badge */
    .status-badge {
        padding: 4px 10px;
        border-radius: 16px;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .status-badge.status-confirmed {
        background: #d1fae5;
        color: #059669;
    }

    .status-badge.status-pending {
        background: #fef3c7;
        color: #d97706;
    }

    .status-badge.status-cancelled {
        background: #fee2e2;
        color: #dc2626;
    }

    /* Category List */
    .category-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .category-item {
        display: grid;
        grid-template-columns: 120px 1fr 80px;
        align-items: center;
        gap: 12px;
        padding: 8px 0;
    }

    .category-name {
        font-weight: 600;
        color: #0f172a;
        font-size: 0.85rem;
    }

    .category-count {
        font-size: 0.7rem;
        color: #64748b;
    }

    .category-bar {
        height: 6px;
        background: #e5e7eb;
        border-radius: 3px;
        overflow: hidden;
    }

