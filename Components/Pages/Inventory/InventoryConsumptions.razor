@page "/inventory/consumptions"
@using Microsoft.EntityFrameworkCore
@using HestiaLink.Models
@using HestiaLink.Data
@using HestiaLink.Services
@inject HestiaLinkContext DbContext
@inject InventoryService InventoryService
@inject IJSRuntime JSRuntime
@layout MainLayout

<div class="page-wrapper">
    <header class="page-topbar">
        <div>
            <h1>Inventory Consumption History</h1>
            <span class="page-topbar-subtitle">Track inventory usage and consumption</span>
        </div>
        <UserDropdown />
    </header>

    <section class="page-content">
        @* ===== FILTERS ===== *@
        <div class="user-toolbar">
            <div class="toolbar-left" style="flex-wrap:wrap; gap:8px;">
                <div class="toolbar-search">
                    <input type="text" placeholder="Search by item name, room..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>

                <select class="filter-select" value="@SelectedRange" @onchange="OnRangeChanged">
                    <option value="Today">Today</option>
                    <option value="Week">This Week</option>
                    <option value="Month">This Month</option>
                    <option value="Year">This Year</option>
                    <option value="Custom">Custom</option>
                </select>
                <span class="range-note">@RangeLabel</span>

                <input type="date" class="filter-select" @bind="StartDate" @bind:format="yyyy-MM-dd" />
                <input type="date" class="filter-select" @bind="EndDate" @bind:format="yyyy-MM-dd" />

                <select class="filter-select" @bind="FilterRoom">
                    <option value="">All Rooms</option>
                    @foreach (var room in Rooms)
                    {
                        <option value="@room">@room</option>
                    }
                </select>
                <select class="filter-select" @bind="FilterService">
                    <option value="">All Services</option>
                    @foreach (var service in Services)
                    {
                        <option value="@service.ServiceId">@service.ServiceName</option>
                    }
                </select>
                <button class="btn-secondary" @onclick="ApplyFilters">Apply Filters</button>
                <button class="btn-secondary" @onclick="ResetFilters">Reset</button>
            </div>
            <div>
                <button class="btn-secondary" @onclick="ExportToExcel" style="margin-right:10px;">Export to Excel</button>
            </div>
        </div>

        @if (!IsLoaded)
        {
            <div class="loading">Loading consumption data...</div>
        }
        else if (HasError)
        {
            <div class="error-message">
                <h4><svg class="icon-inline" viewBox="0 0 24 24" fill="currentColor"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg> Error</h4>
                <p>@ErrorMessage</p>
                <button class="btn-primary" @onclick="RetryLoad">Retry</button>
            </div>
        }
        else
        {
            <div class="panel-card">
                <div class="panel-body user-list-container">
                    @if (FilteredConsumptions.Any())
                    {
                        <table class="user-table">
                            <thead>
                                <tr>
                                    <th>Date & Time</th>
                                    <th>Item Name</th>
                                    <th>Item Code</th>
                                    <th>Quantity</th>
                                    <th>Unit Cost</th>
                                    <th>Total Cost</th>
                                    <th>Room</th>
                                    <th>Service</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var consumption in FilteredConsumptions)
                                {
                                    <tr>
                                        <td>@consumption.ConsumptionDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td style="font-weight:600;">@(consumption.InventoryItem?.ItemName ?? "N/A")</td>
                                        <td style="font-family:monospace;">@(consumption.InventoryItem?.ItemCode ?? "N/A")</td>
                                        <td>@consumption.QuantityConsumed.ToString("N2") @(consumption.InventoryItem?.UnitOfMeasure ?? "")</td>
                                        <td>₱@((consumption.InventoryItem?.UnitCost ?? 0).ToString("N2"))</td>
                                        <td style="font-weight:600;">₱@((consumption.QuantityConsumed * (consumption.InventoryItem?.UnitCost ?? 0)).ToString("N2"))</td>
                                        <td>@(consumption.RoomNumber ?? "-")</td>
                                        <td>@(consumption.ServiceTransaction?.Service?.ServiceName ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <Pagination
                            TotalItems="@TotalFilteredCount"
                            ItemsPerPage="@ItemsPerPage"
                            CurrentPage="@CurrentPage"
                            OnPageChanged="@ChangePage"
                            OnItemsPerPageChangedCallback="@ChangePageSize" />
                    }
                    else
                    {
                        <div class="no-data">No consumption records found for the selected filters.</div>
                    }
                </div>
            </div>
        }
    </section>
</div>

@code {
    // State
    private bool IsLoaded = false;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;
    private string SearchText = "";
    private string SelectedRange = "Month";
    private DateTime StartDate = DateTime.Today.AddDays(-30);
    private DateTime EndDate = DateTime.Today;
    private string FilterRoom = "";
    private int FilterService = 0;
    private int CurrentPage = 1;
    private int ItemsPerPage = 10;
    private int TotalPages = 1;
    private int TotalFilteredCount = 0;

    // Summary
    private int TotalConsumptions = 0;
    private decimal TotalQuantity = 0;
    private decimal TotalCost = 0;
    private int UniqueItems = 0;
    private int UniqueServices = 0;
    private int UniqueRooms = 0;

    // Data
    private List<InventoryConsumption> Consumptions = new();
    private List<InventoryConsumption> FilteredConsumptions = new();
    private List<string> Rooms = new();
    private List<Service> Services = new();

    protected override async Task OnInitializedAsync()
    {
        SelectedRange = "Month";
        UpdateRangeDates();
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            HasError = false;
            ErrorMessage = string.Empty;
            IsLoaded = false;
            StateHasChanged();

            // Load consumptions with related data
            Consumptions = await DbContext.InventoryConsumptions
                .Include(c => c.InventoryItem)
                .Include(c => c.ServiceTransaction)
                    .ThenInclude(st => st!.Service)
                .OrderByDescending(c => c.ConsumptionDate)
                .ToListAsync();

            // Load unique rooms
            Rooms = Consumptions
                .Where(c => !string.IsNullOrEmpty(c.RoomNumber))
                .Select(c => c.RoomNumber!)
                .Distinct()
                .OrderBy(r => r)
                .ToList();

            // Load services
            Services = await DbContext.Services
                .Where(s => s.IsActive == true && s.Status == "Active")
                .OrderBy(s => s.ServiceName)
                .ToListAsync();

            await RefreshSummaryForRange();

            CurrentPage = 1;
            ApplyFilters();
            IsLoaded = true;
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = ex.Message;
            IsLoaded = true;
        }
    }

    private async Task RetryLoad()
    {
        IsLoaded = false;
        StateHasChanged();
        await Task.Delay(500);
        await LoadData();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private async Task OnRangeChanged(ChangeEventArgs e)
    {
        SelectedRange = e.Value?.ToString() ?? "Today";
        UpdateRangeDates();
        CurrentPage = 1;
        await RefreshSummaryForRange();
        ApplyFilters();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        // Ensure start <= end
        if (StartDate > EndDate)
        {
            if (e?.Value?.ToString() == EndDate.ToString("yyyy-MM-dd"))
                StartDate = EndDate;
            else
                EndDate = StartDate;
        }

        SelectedRange = "Custom";
        CurrentPage = 1;
        await RefreshSummaryForRange();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = Consumptions.AsQueryable();

        // Date range filter
        query = query.Where(c => c.ConsumptionDate.Date >= StartDate.Date && c.ConsumptionDate.Date <= EndDate.Date);

        // Search filter
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var searchLower = SearchText.ToLower();
            query = query.Where(c =>
                (c.InventoryItem != null && (c.InventoryItem.ItemName.ToLower().Contains(searchLower) ||
                                            c.InventoryItem.ItemCode.ToLower().Contains(searchLower))) ||
                (!string.IsNullOrEmpty(c.RoomNumber) && c.RoomNumber.ToLower().Contains(searchLower)));
        }

        // Room filter
        if (!string.IsNullOrWhiteSpace(FilterRoom))
        {
            query = query.Where(c => c.RoomNumber == FilterRoom);
        }

        // Service filter
        if (FilterService > 0)
        {
            query = query.Where(c => c.ServiceTransaction != null && c.ServiceTransaction.ServiceId == FilterService);
        }

        TotalFilteredCount = query.Count();
        TotalPages = Math.Max(1, (int)Math.Ceiling(TotalFilteredCount / (double)ItemsPerPage));
        CurrentPage = Math.Clamp(CurrentPage, 1, TotalPages);
        FilteredConsumptions = query
            .Skip((CurrentPage - 1) * ItemsPerPage)
            .Take(ItemsPerPage)
            .ToList();
    }

    private void ResetFilters()
    {
        SearchText = "";
        SelectedRange = "Month";
        UpdateRangeDates();
        FilterRoom = "";
        FilterService = 0;
        CurrentPage = 1;
        _ = RefreshSummaryForRange();
        ApplyFilters();
    }

    private void ChangePage(int page)
    {
        CurrentPage = Math.Clamp(page, 1, TotalPages);
        ApplyFilters();
    }

    private void ChangePageSize(int size)
    {
        ItemsPerPage = size;
        CurrentPage = 1;
        ApplyFilters();
    }

    private void UpdateRangeDates()
    {
        var today = DateTime.Today;
        switch (SelectedRange)
        {
            case "Week":
                StartDate = today.AddDays(-6);
                EndDate = today;
                break;
            case "Month":
                StartDate = new DateTime(today.Year, today.Month, 1);
                EndDate = today;
                break;
            case "Year":
                StartDate = new DateTime(today.Year, 1, 1);
                EndDate = today;
                break;
            case "Today":
                StartDate = today;
                EndDate = today;
                break;
            default:
                // Custom keeps user-selected dates
                if (StartDate > EndDate)
                {
                    EndDate = StartDate;
                }
                SelectedRange = "Custom";
                break;
        }
    }

    private async Task RefreshSummaryForRange()
    {
        var summary = await InventoryService.GetConsumptionReportSummaryAsync(StartDate, EndDate);
        TotalConsumptions = summary.TotalConsumptions;
        TotalQuantity = summary.TotalQuantity;
        TotalCost = summary.TotalCost;
        UniqueItems = summary.UniqueItems;
        UniqueServices = summary.UniqueServices;
        UniqueRooms = summary.UniqueRooms;
    }

    private string RangeLabel => StartDate.Date == EndDate.Date
        ? StartDate.ToString("MMM dd, yyyy")
        : $"{StartDate:MMM dd, yyyy} - {EndDate:MMM dd, yyyy}";

    private async Task ExportToExcel()
    {
        try
        {
            // Create CSV content
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("Date,Item Name,Item Code,Quantity,Unit Cost,Total Cost,Room,Service");

            foreach (var consumption in FilteredConsumptions)
            {
                var itemName = consumption.InventoryItem?.ItemName ?? "N/A";
                var itemCode = consumption.InventoryItem?.ItemCode ?? "N/A";
                var unitCost = consumption.InventoryItem?.UnitCost ?? 0;
                var totalCost = consumption.QuantityConsumed * unitCost;
                var room = consumption.RoomNumber ?? "-";
                var service = consumption.ServiceTransaction?.Service?.ServiceName ?? "N/A";

                csv.AppendLine($"{consumption.ConsumptionDate:yyyy-MM-dd HH:mm},{itemName},{itemCode},{consumption.QuantityConsumed},{unitCost},{totalCost},{room},{service}");
            }

            // Download file
            var fileName = $"InventoryConsumptions_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, csv.ToString(), "text/csv");
            await JSRuntime.InvokeVoidAsync("alert", "Export completed successfully!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error exporting: {ex.Message}");
        }
    }
}

